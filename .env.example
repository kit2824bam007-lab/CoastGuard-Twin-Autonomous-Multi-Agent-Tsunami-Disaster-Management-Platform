# ==============================================================================
# CoastGuard Twin — Unified Development Environment Variables (.env.example)
# Copy this file to .env before starting services with docker compose
# ==============================================================================

# --- Application Environment ---
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL & TimescaleDB Configuration ---
POSTGRES_USER=tsunami_user
POSTGRES_PASSWORD=tsunami_secure_dev_password
POSTGRES_DB=tsunami_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://tsunami_user:tsunami_secure_dev_password@postgres:5432/tsunami_db

# --- Redis Cache & Pub/Sub ---
REDIS_HOST=redis
REDIS_PORT=6380
REDIS_URL=redis://redis:6379/0

# --- Eclipse Mosquitto MQTT Broker ---
MQTT_BROKER_HOST=mqtt-broker
MQTT_BROKER_PORT=1884
MQTT_WS_PORT=9002

# --- Backend Application Server ---
BACKEND_PORT=8001
API_KEY=change_me_to_a_long_random_dev_string
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend Application ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8001

# --- External Feeds (Optional / Live Mode) ---
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/significant_week.geojson
NOAA_TSUNAMI_ATOM_URL=https://www.tsunami.gov/events/xml/PAAQAtom.xml
POLL_INTERVAL_SECONDS=60
