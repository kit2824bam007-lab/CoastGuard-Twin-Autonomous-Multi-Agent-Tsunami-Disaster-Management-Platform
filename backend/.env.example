# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+asyncpg://tsunami_user:tsunami_pass@localhost:5432/tsunami_db

# --- Data sources ---
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/significant_week.geojson
NOAA_TSUNAMI_ATOM_URL=https://www.tsunami.gov/events/xml/PAAQAtom.xml
POLL_INTERVAL_SECONDS=60

# --- Risk thresholds (rule-based MVP) ---
MIN_MAGNITUDE_FOR_ALERT=6.5
MAX_DEPTH_KM_FOR_HIGH_RISK=70

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
ALERT_PHONE_NUMBERS=+919999999999,+911234567890

# --- Firebase (push notifications) ---
FIREBASE_CREDENTIALS_JSON=./firebase-service-account.json
FIREBASE_TOPIC=tsunami-alerts

# --- Security ---
API_KEY=change_me_to_a_long_random_string
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
